#!/usr/bin/env bash
# Run Smart Terminal straight from the checkout (no install needed).
# Prefers the project venv created by ./install.sh.
DIR="$(cd "$(dirname "$0")" && pwd)"
PY="$DIR/.venv/bin/python"
[ -x "$PY" ] || PY="${PYTHON:-python3}"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" "$DIR/cli.py" "$@"
